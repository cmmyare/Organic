# Copy to .env and fill in. Never commit real values.
NODE_ENV=development            # development | test | staging | production
LOG_LEVEL=info

# Express binds here. Keep 127.0.0.1 in production (only Nginx is public).
BIND_HOST=127.0.0.1
ADMIN_PORT=3001
API_PORT=3002

# Separate databases per environment, e.g. organic (dev), organic_staging, organic_prod.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/organic?retryWrites=true&w=majority&appName=<app>

# Admin sessions (required by the admin server; the API does not use it).
# Hosted Redis usually gives a rediss:// (TLS) URL: rediss://default:<password>@<host>:<port>
SESSION_REDIS_URL=

# Optional: database for `npm test`. Default = MONGO_URI with the database renamed to organic_test.
# TEST_MONGO_URI=

# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
APP_TIMEZONE=Africa/Mogadishu
