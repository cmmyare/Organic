<%- include('../partials/head') %>
<main class="origin-login">
  <div class="card origin-card origin-login-card">
    <div class="card-body p-4">
      <div class="text-center mb-4">
        <img src="/public/images/logo.svg" alt="" width="56" height="56">
        <h1 class="h4 mt-2 mb-0"><%= brand.name %> Admin</h1>
        <p class="text-secondary small mb-0"><%= brand.tagline %></p>
      </div>

      <% if (error) { %>
        <div class="alert alert-danger py-2" role="alert"><%= error %></div>
      <% } %>

      <form method="post" action="/login" novalidate>
        <input type="hidden" name="_csrf" value="<%= csrf_token %>">
        <div class="mb-3">
          <label for="email" class="form-label">Email</label>
          <input type="email" class="form-control" id="email" name="email" value="<%= email %>" autocomplete="username" required autofocus>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input type="password" class="form-control" id="password" name="password" autocomplete="current-password" required>
        </div>
        <button type="submit" class="btn btn-origin w-100">Sign in</button>
      </form>
    </div>
  </div>
</main>
<%- include('../partials/foot') %>
