<%# Built server-side from the admins' active, granted menus (res.locals.menu_tree). %>
<aside class="offcanvas-lg offcanvas-start origin-sidebar" tabindex="-1" id="origin_sidebar" aria-label="Main menu">
  <div class="offcanvas-header d-lg-none">
    <span class="fw-bold">Menu</span>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#origin_sidebar" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body p-0">
    <ul class="nav flex-column w-100 py-2">
      <li class="nav-item">
        <a class="nav-link <%= current_path === '/dashboard' ? 'active' : '' %>" href="/dashboard">Dashboard</a>
      </li>
      <% menu_tree.forEach((parent) => { %>
        <li class="nav-item">
          <% if (parent.url) { %>
            <a class="nav-link <%= current_path === parent.url ? 'active' : '' %>" href="<%= parent.url %>"><%= parent.title %></a>
          <% } else { %>
            <span class="nav-link origin-nav-group"><%= parent.title %></span>
          <% } %>
          <% if (parent.children.length) { %>
            <ul class="nav flex-column">
              <% parent.children.forEach((child) => { %>
                <li class="nav-item">
                  <a class="nav-link origin-nav-child <%= current_path === child.url ? 'active' : '' %>" href="<%= child.url %>"><%= child.title %></a>
                </li>
              <% }) %>
            </ul>
          <% } %>
        </li>
      <% }) %>
    </ul>
  </div>
</aside>
